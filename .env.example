# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/smart-link-router
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-link-router
MONGODB_URI=mongodb://127.0.0.1:27017/smart-link-router

# Secret used to sign admin session tokens (JWT). Use any long random string.
JWT_SECRET=replace-with-a-long-random-string

# Admin login credentials for the /admin console.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
